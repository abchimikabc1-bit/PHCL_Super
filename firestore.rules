rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * * ============================================================
     * PH * PHCL SUPER — FIRESTORE SECURITY RULES
     * Web2 + Web3 / Global Security Baseline
     * ============================================================
     *
     * Firebase * Firebase Admin SDK is is the authority for privileged writes.
     * Every client path not explicitly allowed below is denied.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function hasAuthenticatedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.auth.token.email.size() <= 320;
    }

    function isValidCustomerTier(tier) {
      return tier == 'regular'
        || tier == 'small_business'
        || tier == 'corporate';
    }

    function hasOnlySafeInitialProfileFields(data) {
      return data.keys().hasOnly([
        'uid',
        'email',
        'fullName',
        'phone',
        'role',
        'tier',
        'kycStatus',
        'balances',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasZeroInitialBalances(data) {
      return data.balances is map
        && data.balances.keys().hasOnly([
          'usd',
          'tzs',
          'ntzs',
          'pi'
        ])
        && data.balances.usd == 0
        && data.balances.tzs == 0
        && data.balances.ntzs == 0
        && data.balances.pi == 0;
    }

    function hasValidBasicProfile(data) {
      return data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 120

        && data.phone is string
        && data.phone.size() <= 40;
    }

    /*
     * A customer may create only their own least-privileged profile.
     *
     * The token email is Firebase Authentication authority. It need
     * not yet be verified when the initial profile is created, but a
     * caller cannot place another person's email in the document.
     */
    function isSafeCustomerCreate(userId) {
      return isOwner(userId)
        && hasAuthenticatedEmail()
        && hasOnlySafeInitialProfileFields(
          request.resource.data
        )

        && request.resource.data.uid == userId
        && request.resource.data.email
          == request.auth.token.email
        && request.resource.data.role == 'user'

        && hasValidBasicProfile(
          request.resource.data
        )

        && isValidCustomerTier(
          request.resource.data.tier
        )

        && request.resource.data.kycStatus
          == 'NOT_STARTED'

        && hasZeroInitialBalances(
          request.resource.data
        )

        && request.resource.data.createdAt
          == request.time
        && request.resource.data.updatedAt
          == request.time;
    }

    /*
     * Customer-editable profile fields only.
     *
     * All identity, role, tier, verification, account-standing,
     * compliance and financial fields remain immutable to clients.
     */
    function isSafeCustomerUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'fullName',
          'phone',
          'updatedAt'
        ])

        && hasValidBasicProfile(
          request.resource.data
        )

        && request.resource.data.updatedAt
          == request.time;
    }

    /*
     * ============================================================
     * CUSTOMER PROFILES
     * ============================================================
     */

    match /users/{userId} {
      allow read:
        if isOwner(userId);

      allow create:
        if isSafeCustomerCreate(userId);

      allow update:
        if isOwner(userId)
        && isSafeCustomerUpdate();

      /*
       * Account deletion must use a controlled server workflow.
       */
      allow delete:
        if false;
    }

    /*
     * ============================================================
     * LEGACY CUSTOMER TRANSACTION HISTORY
     * ============================================================
     *
     * This collection remains read-only to its owner for current
     * compatibility. Clients can never create or mutate records.
     *
     * The authoritative financial_accounts, financial_ledger and
     * financial_operations collections are intentionally not exposed;
     * they remain protected by the default-deny rule below.
     */

    match /transactions/{transactionId} {
      allow read:
        if isSignedIn()
        && resource.data.userId is string
        && resource.data.userId
          == request.auth.uid;

      allow create, update, delete:
        if false;
    }

    /*
     * ============================================================
     * DEFAULT DENY
     * ============================================================
     */

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}