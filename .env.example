# ============================================================
# PHCL SUPER — ENVIRONMENT VARIABLE TEMPLATE
# ============================================================
#
# Copy this file to .env.local for local development.
# Never commit .env.local or any real credential.
#
# Leave secret values empty in this example file.
# ============================================================

# ------------------------------------------------------------
# Public site configuration
# ------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://www.phclsuper.com
NEXT_PUBLIC_API_URL=https://api.phclsuper.com
NEXT_PUBLIC_APP_NAME=PHCL Super

# ------------------------------------------------------------
# Firebase client configuration
#
# These values are exposed to the browser by design.
# Authorization must still be enforced by Firebase Rules
# and protected server APIs.
# ------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# Firebase Admin SDK
#
# Server-only. Never prefix these with NEXT_PUBLIC_.
#
# FIREBASE_PRIVATE_KEY may be stored as one quoted line
# containing literal \n newline markers.
# ------------------------------------------------------------

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------
# Analytics
# ------------------------------------------------------------

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SEGMENT_ID=

# ------------------------------------------------------------
# Payment providers
#
# Server secrets must never use NEXT_PUBLIC_.
# ------------------------------------------------------------

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ------------------------------------------------------------
# Crypto and market-data APIs
#
# Only place keys here if the provider explicitly permits
# browser exposure. Private provider keys must be server-only.
# ------------------------------------------------------------

NEXT_PUBLIC_COINGECKO_API_KEY=
NEXT_PUBLIC_BLOCKCHAIN_API_KEY=

# ------------------------------------------------------------
# Email service
#
# SENDGRID_API_KEY is server-only.
# Do not create NEXT_PUBLIC_SENDGRID_API_KEY.
# ------------------------------------------------------------

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@phclsuper.com

# ------------------------------------------------------------
# Optional legacy database configuration
#
# Retain only while referenced by application code.
# ------------------------------------------------------------

DATABASE_URL=

# ------------------------------------------------------------
# Pi Network SDK
# ------------------------------------------------------------

NEXT_PUBLIC_PI_SDK_ENABLED=true

# ------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------

NEXT_PUBLIC_ENABLE_CRYPTO_PAYMENTS=true
NEXT_PUBLIC_ENABLE_FIAT_PAYMENTS=true
NEXT_PUBLIC_ENABLE_MULTI_LANGUAGE=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# ------------------------------------------------------------
# Performance
# ------------------------------------------------------------

NEXT_PUBLIC_CACHE_STRATEGY=swr
NEXT_PUBLIC_REVALIDATE_TIME=3600

# ------------------------------------------------------------
# Public security feature flags
#
# These flags do not replace real server security headers.
# ------------------------------------------------------------

NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_ENABLE_HSTS=true

# ------------------------------------------------------------
# PHCL Admin authentication
#
# Server-only.
# ------------------------------------------------------------

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800

ADMIN_AUTH_AUDIT_LOG_PATH=generated/security/admin-auth-audit.log
ADMIN_AUTH_RATE_LIMIT_PATH=generated/security/admin-auth-rate-limit.json

# ------------------------------------------------------------
# Customer transfer abuse prevention
#
# Server-only.
# ------------------------------------------------------------

TRANSFER_RATE_LIMIT_SECRET=
TRANSFER_RATE_LIMIT_WINDOW_SECONDS=600
TRANSFER_RATE_LIMIT_BLOCK_SECONDS=900
TRANSFER_RATE_LIMIT_MAX_ACCOUNT_REQUESTS=8
TRANSFER_RATE_LIMIT_MAX_NETWORK_REQUESTS=30

# ------------------------------------------------------------
# Customer withdrawal security
#
# Server-only.
#
# WITHDRAWAL_DATA_ENCRYPTION_KEY must be a base64url-encoded
# random 32-byte key. It encrypts payout destination data.
#
# Withdrawal requests expire after 24 hours by default.
# Expiry does not mean a completed financial settlement.
# ------------------------------------------------------------

WITHDRAWAL_DATA_ENCRYPTION_KEY=
WITHDRAWAL_REQUEST_EXPIRY_SECONDS=86400

# ------------------------------------------------------------
# Customer deposit request security
#
# Server-only.
#
# Deposit request expiry controls how long a pending deposit
# intent remains eligible for provider initiation.
#
# Expiry never proves that funds were received and must never
# credit a customer balance.
# ------------------------------------------------------------

DEPOSIT_REQUEST_EXPIRY_SECONDS=1800

# ------------------------------------------------------------
# Provider callback security
#
# Server-only.
#
# Every HMAC-based provider must use a separate random secret.
# Store real values only in .env.local or the production
# secret manager.
#
# TIGO_PESA is represented by its current provider code:
# MIXX_BY_YAS.
# ------------------------------------------------------------

PROVIDER_CALLBACK_MAX_AGE_SECONDS=300
PROVIDER_CALLBACK_MAX_BODY_BYTES=65536

PROVIDER_CALLBACK_SECRET_MPESA=
PROVIDER_CALLBACK_SECRET_AIRTEL_MONEY=
PROVIDER_CALLBACK_SECRET_HALOPESA=
PROVIDER_CALLBACK_SECRET_MIXX_BY_YAS=
PROVIDER_CALLBACK_SECRET_PI_NETWORK=

# ------------------------------------------------------------
# Active payment-provider environment
#
# Production deployments must explicitly use PRODUCTION.
# ------------------------------------------------------------

PAYMENT_PROVIDER_ENVIRONMENT=SANDBOX

# ------------------------------------------------------------
# M-Pesa sandbox adapter
# ------------------------------------------------------------

MPESA_SANDBOX_CALLBACK_SECRET=
MPESA_SANDBOX_CALLBACK_MAX_AGE_SECONDS=300

# ------------------------------------------------------------
# Airtel Money sandbox adapter
# ------------------------------------------------------------

AIRTEL_MONEY_SANDBOX_CALLBACK_SECRET=
AIRTEL_MONEY_SANDBOX_CALLBACK_MAX_AGE_SECONDS=300

# ------------------------------------------------------------
# HaloPesa sandbox adapter
# ------------------------------------------------------------

HALOPESA_SANDBOX_CALLBACK_SECRET=
HALOPESA_SANDBOX_CALLBACK_MAX_AGE_SECONDS=300

# ------------------------------------------------------------
# Mixx by Yas sandbox adapter
# ------------------------------------------------------------

MIXX_BY_YAS_SANDBOX_CALLBACK_SECRET=
MIXX_BY_YAS_SANDBOX_CALLBACK_MAX_AGE_SECONDS=300

# ------------------------------------------------------------
# PayPal sandbox adapter
#
# Server-only. Obtain these values from the PayPal Developer
# Dashboard sandbox application.
#
# PAYPAL_SANDBOX_CLIENT_SECRET must never be exposed through
# NEXT_PUBLIC_, browser responses, logs or Firestore.
#
# PAYPAL_SANDBOX_WEBHOOK_ID identifies the registered webhook
# used when verifying PayPal callback signatures.
# ------------------------------------------------------------

PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=