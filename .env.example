# PHCL Super Environment Variables
# Copy this file to .env.local and fill in the actual values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.phclsuper.com
NEXT_PUBLIC_API_URL=https://api.phclsuper.com
NEXT_PUBLIC_APP_NAME=PHCL Super

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SEGMENT_ID=

# Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Admin Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# External Service Secrets
COINGECKO_API_KEY=
BLOCKCHAIN_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@phclsuper.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Database (if using)
DATABASE_URL=

# Auth (if using NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://phclsuper.com

# Pi Network SDK
NEXT_PUBLIC_PI_SDK_ENABLED=true

# Feature Flags
NEXT_PUBLIC_ENABLE_CRYPTO_PAYMENTS=true
NEXT_PUBLIC_ENABLE_FIAT_PAYMENTS=true
NEXT_PUBLIC_ENABLE_MULTI_LANGUAGE=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Performance
NEXT_PUBLIC_CACHE_STRATEGY=swr
NEXT_PUBLIC_REVALIDATE_TIME=3600

# Security
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
ADMIN_AUTH_AUDIT_LOG_PATH=generated/security/admin-auth-audit.log
ADMIN_AUTH_RATE_LIMIT_PATH=generated/security/admin-auth-rate-limit.json
CSP_POLICY_STRING=
HSTS_MAX_AGE=31536000
