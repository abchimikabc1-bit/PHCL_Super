# SECURITY ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO GIT REPOSITORIES!

# APP CONFIGURATION
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://myapp.domain.com,https://admin.domain.com

# DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secure_app_db
DB_USER=app_user
DB_PASSWORD=REPLACE_WITH_SECURE_RANDOM_PASSWORD

# FIREBASE CONFIGURATION
FIREBASE_PROJECT_ID=my-secure-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@my-secure-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# JWT / SESSION SECURITY
JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_STRING
SESSION_SECRET=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_STRING
