# PHCL Super environment template
# Copy this file to .env.local and replace placeholder values with your own secrets.

# Core site config
NEXT_PUBLIC_SITE_URL=https://www.phclsuper.com
NEXT_PUBLIC_API_URL=https://api.phclsuper.com
NEXT_PUBLIC_APP_NAME=PHCL Super

# Admin auth
ADMIN_EMAIL=admin@phclsuper.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_SESSION_IDLE_TIMEOUT_SECONDS=1800
ADMIN_AUTH_AUDIT_LOG_PATH=generated/security/admin-auth-audit.log
ADMIN_AUTH_RATE_LIMIT_PATH=generated/security/admin-auth-rate-limit.json

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (optional unless server-side Firebase admin routes are enabled)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Feature flags
NEXT_PUBLIC_PI_SDK_ENABLED=true
NEXT_PUBLIC_ENABLE_CRYPTO_PAYMENTS=true
NEXT_PUBLIC_ENABLE_FIAT_PAYMENTS=true
NEXT_PUBLIC_ENABLE_MULTI_LANGUAGE=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Performance
NEXT_PUBLIC_CACHE_STRATEGY=swr
NEXT_PUBLIC_REVALIDATE_TIME=3600

# Security toggles
NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_ENABLE_HSTS=true
