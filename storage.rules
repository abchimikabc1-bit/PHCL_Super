rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /*
     * ============================================================
     * PHCL SUPER — GLOBAL MEDIA STORAGE SECURITY
     * PHCL Global Media Pipeline v1
     * ============================================================
     *
     * Security model:
     *
     * 1. Client access is denied by default.
     * 2. Direct client access to private ingest objects is denied.
     * 3. Media upload authority is granted only through trusted
     *    server-side flows.
     * 4. Processed media, thumbnails and quarantine objects are
     *    server/service controlled.
     * 5. Public delivery will NOT depend on making raw storage
     *    objects publicly writable.
     */

    /*
     * ------------------------------------------------------------
     * PRIVATE RAW VIDEO INGEST
     * ------------------------------------------------------------
     *
     * Expected path:
     *
     * media/ingest/{userId}/{mediaId}/{fileName}
     *
     * Direct client access to ingest objects is denied.
     * Upload authority is granted only through trusted server-side flows.
     * Processing services use privileged server credentials and are
     * not governed by these client rules.
     */
    match /media/ingest/{userId}/{mediaId}/{fileName} {
      allow read, write:
        if false;
    }

    /*
     * ------------------------------------------------------------
     * PROCESSED MEDIA
     * ------------------------------------------------------------
     *
     * HLS manifests, segments, MP4 renditions and other generated
     * delivery assets are server controlled.
     */
    match /media/processed/{allPaths=**} {
      allow read, write:
        if false;
    }

    /*
     * ------------------------------------------------------------
     * THUMBNAILS
     * ------------------------------------------------------------
     */
    match /media/thumbnails/{allPaths=**} {
      allow read, write:
        if false;
    }

    /*
     * ------------------------------------------------------------
     * QUARANTINE
     * ------------------------------------------------------------
     *
     * Rejected or suspicious source objects must never be exposed
     * directly to clients.
     */
    match /media/quarantine/{allPaths=**} {
      allow read, write:
        if false;
    }

    /*
     * ------------------------------------------------------------
     * DEFAULT DENY
     * ------------------------------------------------------------
     */
    match /{allPaths=**} {
      allow read, write:
        if false;
    }
  }
}
